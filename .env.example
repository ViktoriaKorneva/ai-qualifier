# Модель для свободных вопросов. Без этих переменных бот работает
# на правилах и базе знаний — это штатный режим, а не поломка.
# Реальные ключи класть только в .env, он в .gitignore.
AI_TEXT_BASE_URL=https://api.odirouter.ai/v1
AI_TEXT_API_KEY=
AI_TEXT_MODEL=
AI_TEXT_TIMEOUT=30

# YandexGPT — когда данные должны остаться в российском контуре.
# Эндпоинт OpenAI-совместимый, поэтому меняются только эти строки, код не трогаем:
# AI_TEXT_BASE_URL=https://llm.api.cloud.yandex.net/v1
# AI_TEXT_MODEL=gpt://<идентификатор-каталога>/yandexgpt/latest
